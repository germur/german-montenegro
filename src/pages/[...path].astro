---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteApp from '../../components/ClientApp.jsx';
import { PAGE_TO_PATH } from '../../lib/routes.js';
import { PAGE_SEO, DEFAULT_DESCRIPTION, pageTitle } from '../../lib/seo.js';

export function getStaticPaths() {
  return Object.entries(PAGE_TO_PATH).map(([page, path]) => ({
    params: { path: path === '/' ? undefined : path.slice(1) },
    props: { page, path },
  }));
}

const { page, path } = Astro.props;
const seo = PAGE_SEO[page];
const title = pageTitle(page);
const description = seo.description || DEFAULT_DESCRIPTION;
---
<SiteLayout title={title} description={description} path={path} page={page}>
  <SiteApp page={page} client:load />
</SiteLayout>
